# Credentials for jira-multisite-mcp.
#
# Copy to ~/.config/jira-multisite-mcp/.env (next to sites.yml), fill it in
# and protect it:
#
#   cp .env.example ~/.config/jira-multisite-mcp/.env
#   chmod 600 ~/.config/jira-multisite-mcp/.env
#
# A .env at the root of this repository also works (git ignores it).
# Variables already set by your MCP client win over this file.

ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-token

# A site with `token_env: OTHER_CLIENT_ATLASSIAN_TOKEN` in sites.yml:
# OTHER_CLIENT_ATLASSIAN_TOKEN=its-token
